# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_DATABASE=approval_center

# FastAPI
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8090

# 租户管理接口临时管理密钥。正式部署必须替换为高强度随机值。
APPROVAL_ADMIN_KEY=replace-with-a-strong-random-admin-key

# 是否启用租户资源过滤和绑定。
TENANCY_ENABLED=true

# 回调凭据加密主密钥。使用 README 中的命令生成，不要复用示例值。
# 业务执行 Worker 默认启用，必须配置本项才能启动。
APPROVAL_CREDENTIAL_MASTER_KEY=replace-with-a-generated-fernet-key

# 业务执行 Worker。审批通过后由它在后台调用业务系统接口并记录结果。
# 关闭后审批通过仍然创建 PENDING 执行记录，只是当前进程不领取任务。
BUSINESS_EXECUTION_WORKER_ENABLED=true

# 没有可执行任务时两次查询之间的等待秒数，必须大于 0。
BUSINESS_EXECUTION_POLL_INTERVAL_SECONDS=2

# 每次最多领取的 PENDING 记录数量，必须是正整数。
BUSINESS_EXECUTION_BATCH_SIZE=10

# 当前进程内同时执行的最大 HTTP 请求数量，必须是正整数且不能大于批量领取数量。
BUSINESS_EXECUTION_CONCURRENCY=5
