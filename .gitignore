# ---------- 环境变量 / 密钥（最重要，绝不能提交）----------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# 虚拟环境
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.cache/
pip-wheel-metadata/

# ---------- 日志 ----------
*.log
logs/
log/

# ---------- 运行时数据 / 上传文件 ----------
# 本项目是 AI 平台，向量库、上传文档、临时文件都不该进版本库
uploads/
downloads/
storage/
temp/
tmp/
# data/ 下的运行时产物不进版本库，但统一初始化 SQL 是数据库结构的唯一来源，
# 必须进版本库。这里用 data/* 而不是 data/，否则被排除的目录内的文件无法重新放行。
data/*
!data/init.sql
*.db
*.sqlite
*.sqlite3

# ---------- Playwright / 爬虫产物 ----------
.playwright/
playwright-report/
test-results/
playwright/.cache/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- Node / 前端构建（若以后加前端）----------
node_modules/
.next/
out/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 其他 ----------
*.bak
*.orig
*.rej
