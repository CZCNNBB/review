# 假业务系统的配置。复制成 .env 再改，命令行参数优先于这里（.env 不进版本库）。
#
# 前四项是审批中心那边的，剩下的是这个脚本自己的。

# 审批中心地址。
CENTER=http://127.0.0.1:8090

# 管理密钥，可选。填了启动时会列出可选的审批流与业务动作，省得去控制台抄 ID。
ADMIN_KEY=

# 租户 API Key：控制台 → 租户 → 详情页签发。发起审批用它，别填管理密钥。
API_KEY=

# 审批流 ID 与业务动作编码：发起审批用；ACTION_CODE 留空表示只走审批、通过后不回调。
PROCESS_ID=
ACTION_CODE=

# 假业务系统自己。
HOST=127.0.0.1
PORT=9000

# 支付回调的路径，要与业务动作的相对路径一致。
PAY_PATH=/pay

# 回调返回的状态码。填 500 可以测执行记录的失败分支。
STATUS=200

# 回调收到后先等几秒再回，用来测业务动作的超时（timeout_ms）。0 表示立即返回。
DELAY=0

# Service Token 放在哪个请求头，以及期望的值：填了 EXPECT_TOKEN，收到回调时会核对并打 √/×。
TOKEN_HEADER=X-Service-Token
EXPECT_TOKEN=
